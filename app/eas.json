{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "production"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "development": {
        "developmentClient": true,
        "distribution": "internal",
        "android": { "buildType": "apk" },
    "channel": "development"
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator"
    }
  },
  "submit": {
    "production": {}
  }
}
