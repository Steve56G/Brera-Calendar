{
  "expo": {
    "name": "Brera Calendar",
    "slug": "orario-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./src/assets/logo_brera.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo_brera.png",
          "imageWidth": 200,
          "backgroundColor": "#F3F4F6"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steve56g.breracalendar",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.steve56g.breracalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6E6E6",
        "foregroundImage": "./src/assets/logo_brera.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./src/assets/logo_brera.png"
    },
    "extra": {
      "eas": {
        "projectId": "4009e335-db79-4025-b76a-d64def4fb972"
      }
    },
    "owner": "melondogenjoyer"
  }
}
